; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shooter"
run/main_scene="res://Scenes/start.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://Sprites/Cute_Fantasy_Characters/Tiles/icon.svg"

[autoload]

ArcherUpgradeDb="*res://Resources/archer_upgrade_db.tscn"

[file_customization]

folder_colors={
"res://Music/": "yellow",
"res://Resources/": "green",
"res://Scripts/": "red",
"res://Sounds/": "yellow",
"res://Sprites/": "green"
}

