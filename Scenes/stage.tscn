[sub_resource type="GDScript" id="GDScript_6neef"]
resource_name = "Stage"
script/source = "extends Node2D
@export var Damage: int = 9
@export var HP: int = 20
@export var Knockback: float = 150.0
@export var EXP: int = 0
var Damageable: bool = true
var LvlUI = preload(\"res://Scenes/leveling_ui.tscn\")

#信號
signal DebugBtn

# Called when the node enters the scene tree for the first time.
func _ready():
	#connect()
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta):
	if Input.is_action_just_pressed(\"Debug\"):
		pass
		#LevelUp()

func _on_defense_area_body_entered(body):
	if body.is_in_group(\"Enemy\"):
		if Damageable:
			HP -= body.Damage
			body.velocity.x -= Knockback
			body.take_damage(Damage, Knockback)
			print(\"Damage: \", body.Damage, \"Base HP: \", HP)
			
		if HP <= 0:
			gameover()

func gameover():
	print(\"gameover\")
	get_tree().paused = true #將get_tree 抓到的場景樹全都暫停 -> 到時候要叫出來可以點擊的 UI 要被排除


func _on_border_left_body_exited(body):
	if body.is_in_group(\"Projectiles\"):
		print(\"Projectile Leaving Border\")
		body.queue_free()


#func LevelUp ():
#	get_tree().paused = true
#	var Leveling = LvlUI.instantiate()
#	get_parent().add_child(Leveling)
#	Leveling.get_path()
#	print(Leveling.get_path())
#	var tween = get_node(Leveling.get_path()).create_tween()
#	tween.tween_property(get_node(Leveling.get_path()), \"position\", Vector2(0, 30), 0.3)


func _on_wave_timer_timeout():
	print(\"Stage Clear!\")
	gameover()
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_pjoiv"]
size = Vector2(295, 494)

[sub_resource type="GDScript" id="GDScript_sh1en"]
script/source = "extends Node2D

var SpawnSkel = preload(\"res://Scenes/NPCs/Skeleton.tscn\")
var SpawnSlime = preload(\"res://Scenes/NPCs/slime.tscn\")
var SpawnShroom = preload(\"res://Scenes/NPCs/Shroomling.tscn\")
@export var SpawnList = []

@export var SpawnCount: int = 100
@export var MinEnemyPerWave: int = 3
@export var MaxEnemyPerWave: int = ceil(SpawnCount /10)
@export var WaveTimeSec: int = 60
@export var MinorWaveTimer: int = 6

@onready var SpawnTimer = get_node(\"SpawnTimer\")
@onready var WaveTimer = get_node(\"WaveTimer\")
@onready var Ground = get_child(0).get_node(\"SpawnArea\") 						#取得生怪區的位，i.e. SpawnArea 的中心點
@onready var GCenter = Ground.global_position
@onready var GSize = Ground.get_shape().size 									#取得 SpawnArea.Shape 底下的 X, Y Size (Vector2)
@onready var Air =get_child(1).get_node(\"SpawnArea\").global_position

#TODO:
#關卡開始時決定生怪數量 A (or total 戰力)
#關卡倒數計時，一關固定60 sec / 5波
#一波 12 秒，每波分到固定的生怪數量 (A/5)
#用隨機 x 位置控制生怪波的前後位置...? X 或許可以拉長生怪的X範圍


func _ready():
	WaveTimer.wait_time = WaveTimeSec
	WaveTimer.start()
	SpawnTimer.start()
	
	#TODO: 設計隨關卡增加出場怪種類的方法
	SpawnList.append(SpawnSkel)
	SpawnList.append(SpawnSlime)
	SpawnList.append(SpawnShroom)


func _on_spawn_timer_timeout():
	#print(\"Timeout\") 
	#var Enemy_Instance = SpawnSkel.instantiate()
	#get_parent().add_child(Enemy_Instance)
	
	SpawnCount = randi_range(MinEnemyPerWave, MaxEnemyPerWave)
	print(\"SpawnCount: \", SpawnCount)
	for i in SpawnCount:
		if i <=  SpawnCount:
			var Enemy_Instance = SpawnList[randi_range(0, len(SpawnList) - 1)].instantiate()
			get_parent().add_child(Enemy_Instance)
			Enemy_Instance.global_position = Vector2(randf_range(GCenter.x - GSize.x / 2, GCenter.x + GSize.x / 2), randf_range(GCenter.y - GSize.y / 2, GCenter.y + GSize.y / 2)) #取得 SpawnArea 的 X Y Size, X/2 、Y/2 即等於生怪的最左、最右的 X位置
		print(i)
		i += 1
	SpawnTimer.wait_time = randi_range(1, MinorWaveTimer)
	SpawnTimer.start()
"

