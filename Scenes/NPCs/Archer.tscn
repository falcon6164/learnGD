[sub_resource type="GDScript" id="GDScript_eulrj"]
script/source = "extends CharacterBody2D

@export var Damage = 9
@export var ReloadSpeed: float = 2.0
@export var Knockback: float = 20.0
@export var MaxChargeGauge: float = 100.0

var ChargeGauge: float:
	set(value):
		ChargeGauge = clamp(value, 0, MaxChargeGauge)
@export var ChargeSpeed: float = 40.0

@onready var AttackTimer = $AttackTimer
@onready var Weapon = $WeaponSprite

enum States {idle, attack}
@onready var current_state: States = States.idle

#攻擊投射物等
var arrow = preload(\"res://Scenes/Attacks/arrow.tscn\")

# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.
	ChargeGauge = 0.0
func _process(_delta):
	var mouse_position = get_global_mouse_position()
	var rad = global_position.angle_to_point(mouse_position) #angle_to_point 會回傳 radians
	var angle = rad_to_deg(rad)
	
	#武器跟隨滑鼠位置旋轉
	Weapon.rotation = rad
	
	
	#按下攻擊鍵後的動作 蓄力攻擊
	if Input.is_action_pressed(\"Attack\"):
		if current_state != States.attack:
			current_state = States.attack
			Weapon.play(\"attack_charge\", 1.0)
	if ChargeGauge <= MaxChargeGauge:
		ChargeGauge += ChargeSpeed * _delta
	if Input.is_action_just_released(\"Attack\"):
		#根據滑鼠點擊的位置以及角色所在位置算出角度
		#var mouse_position = get_global_mouse_position()
		#var rad = global_position.angle_to_point(mouse_position) #angle_to_point 會回傳 radians
		#var angle = rad_to_deg(rad)
		
		print(\"\\n\\nRadians: \", rad, \"\\nAngle: \", angle, \"\\nChargeGauge: \", ChargeGauge)
		Weapon.play(\"attack_release\")
		Attack((Damage * (1 + (ChargeGauge / 100))), rad, angle)
		ChargeGauge = 0.0
		
		#print(\"Mouse position: \", mouse_position, \"Character Position: \", global_position, \"\\n Angle: \", angle, \"\\nRad: \", rad)

# 生成攻擊物
func Attack(dmg, rad, _angle):
	var arrow_attack = arrow.instantiate()
	arrow_attack.damage = dmg
	arrow_attack.dir = rad
	arrow_attack.pos= global_position
	arrow_attack.knockback += Knockback
	get_parent().add_child(arrow_attack)


func _on_weapon_sprite_animation_finished():
		if Weapon.animation == \"attack_release\":
			Weapon.pause()
			current_state = States.idle
"

